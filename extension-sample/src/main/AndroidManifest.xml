<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="Yomu: Demo Source"
        android:hasCode="true">

        <!-- Discovered by Yomu's ExtensionLoader. Value is the SourceFactory class,
             relative to this package (leading dot). -->
        <meta-data
            android:name="com.yomu.reader.extension.class"
            android:value=".DemoSourceFactory" />
        <meta-data
            android:name="com.yomu.reader.extension.sources"
            android:value="Yomu Demo" />
    </application>
</manifest>
